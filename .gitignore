log/
data/

# Variáveis de ambiente
.env
!.env.example

# Pastas e arquivos ocultos (iniciados com ponto)
.*
!.gitignore
!.env.example

# Python bytecode e cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Ambientes virtuais
venv/
.venv/
env/

# Build e distribuição
dist/
build/
*.egg-info/

# SDK e documentação binária da Intelbras (grandes e não-versionáveis)
# Observação: as pastas docs/Defense IA - API e docs/Defense IA - SDK são versionadas
# apenas em seus arquivos textuais; os binários (.dll, .exe, .zip, .lib) seguem
# bloqueados pelas regras globais abaixo.
docs/_extracted/
docs/defense_ia.zip
# Exceção: liberar a pasta .NET do SDK (a regra global ".*" a estava ignorando)
!docs/Defense IA - SDK/.NET/
!docs/Defense IA - SDK/.NET/**

# Arquivos binários / compactados
*.zip
*.tar.gz
*.rar
*.dll
*.exe
*.lib
*.so
*.dylib

# Sistema operacional
Thumbs.db
Desktop.ini
.DS_Store
