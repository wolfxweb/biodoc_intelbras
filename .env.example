# Copie para .env e preencha os valores reais:
#   cp .env.example .env

# Intelbras Defense IA (credenciais da API — nao sao o login do cliente Windows)
# No servidor Defense: usuario de integracao (geralmente "system") e senha definida no painel admin.
# IP publico (WAN): http://200.180.74.90
DEFENSE_IA_SERVER_URL=http://200.180.74.90
# IP interno (VPN): http://192.168.100.250
# IP interno (alternativo): http://192.168.40.2
# Minusculas (ex.: system). "System" falha na 2a authorize neste servidor.
DEFENSE_IA_USERNAME=system
DEFENSE_IA_PASSWORD=senha-do-usuario-api-no-defense
DEFENSE_IA_API_MODE=brms
DEFENSE_IA_CLIENT_TYPE=WINPC_V2
DEFENSE_IA_USER_TYPE=0
# Gerar: python scripts/generate_defense_rsa_keys.py
DEFENSE_IA_PUBLIC_KEY=sua-chave-publica-rsa-base64
# DEFENSE_IA_PRIVATE_KEY=opcional-para-decrypt-secretKey
# Teste rapido (doc 3.1): reutiliza publickey da 1a resposta
DEFENSE_IA_USE_SERVER_PUBLICKEY=false
DEFENSE_IA_ORG_CODE=001
DEFENSE_IA_KEEP_ALIVE_SECONDS=20
DEFENSE_IA_TIMEOUT_SECONDS=10

# Legado: ignorado em POST /v1/person/sync (use bloco defense no JSON).
# Webhook BioDoc sempre cadastra visitante.
# DEFENSE_IA_SYNC_TARGET=visitor
# Opcional: overrides manuais (não necessário — orgCode vem do BioDoc como pessoa ACS)
# DEFENSE_IA_VISITED_PERSON_ID=
# DEFENSE_IA_VISITOR_CHANNEL_MAP={"001021":["1000174$7$0$0"]}
# DEFENSE_IA_VISITOR_CHANNEL_DEFAULT=
# DEFENSE_IA_VISITOR_STATUS=1

# Admin + sync BIODOC (mesmo Bearer). Startup grava hash na source "biodoc".
ADMIN_API_TOKEN=defina-um-token-seguro
DEFAULT_INTEGRATION_SOURCE_NAME=biodoc

# Opcional em producao: chave so do BIODOC (sobrescreve ADMIN no bootstrap)
# BIODOC_INTEGRATION_KEY=

# true = detalhe bruto do Defense em 502 (apenas homologação)
DEFENSE_IA_EXPOSE_ERROR=false

# BioDoc API — consulta de beneficiários e webhook POST /webhook/biodoc
# Sandbox:    BIODOC_API_URL=https://api.sandbox.biodoc.com.br/api
# Produção:   BIODOC_API_URL=https://api.biodoc.com.br/api
BIODOC_API_URL=https://api.sandbox.biodoc.com.br/api
# TOKEN_API do painel BioDoc (Bearer em GET /card/integration/mainimage?idCard=...)
BIODOC_TOKEN_API=seu-token-api-biodoc
# Token do webhook: mesmo valor no painel BioDoc (Authorization: Bearer <token>)
# URL no painel: https://<seu-dominio>/webhook/biodoc
BIODOC_WEBHOOK_TOKEN=seu-token-webhook-biodoc
# Rastreio em logs e GET /status (campo biodoc.ambiente): sandbox | production
# Não escolhe a API sozinho — em produção use BIODOC_API_URL + tokens de produção
BIODOC_AMBIENTE=sandbox

# Vínculo de portas (orgCode):
# O `reguiredName` enviado pelo BioDoc define a sub-organização no Defense IA
# (`baseInfo.orgCode`). Cada sub-org já tem portas vinculadas no painel desktop,
# então o acesso é gerenciado por essa associação — sem mapping no .env.
#
# Dois formatos aceitos no `reguiredName` ou no `details.operador` da URL verify:
#  1) Código direto, ex.: "001015001" (instantâneo, zero busca na API).
#  2) Nome amigável, ex.: "Corb" (lookup em person-group/list, ~200 ms;
#     cache 30 min, aquecido no boot do middleware).
#
# Listar grupos disponíveis (ID e nome):
#   docker compose run --rm middleware-biodoc-intelbras python scripts/list_person_orgs.py
#
# Se nada casar, a pessoa cai em DEFENSE_IA_ORG_CODE (raiz). Para refrescar
# o cache após criar nova sub-org no painel: scripts/list_person_orgs.py --refresh.

# Testes (foto: python scripts/download_test_face.py -> data/test_face.jpg)
TEST_FACE_IMAGE_PATH=data/test_face.jpg
MIDDLEWARE_URL=http://localhost:8000
