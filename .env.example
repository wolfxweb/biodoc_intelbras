# Copie para .env e preencha os valores reais:
#   cp .env.example .env

# Intelbras Defense IA (credenciais da API — nao sao o login do cliente Windows)
# No servidor Defense: usuario de integracao (geralmente "system") e senha definida no painel admin.
# IP publico (WAN): http://200.180.74.90
DEFENSE_IA_SERVER_URL=http://200.180.74.90
# IP interno (VPN): http://192.168.100.250
# IP interno (alternativo): http://192.168.40.2
# Minusculas (ex.: system). "System" falha na 2a authorize neste servidor.
DEFENSE_IA_USERNAME=system
DEFENSE_IA_PASSWORD=senha-do-usuario-api-no-defense
DEFENSE_IA_API_MODE=brms
DEFENSE_IA_CLIENT_TYPE=WINPC_V2
DEFENSE_IA_USER_TYPE=0
# Gerar: python scripts/generate_defense_rsa_keys.py
DEFENSE_IA_PUBLIC_KEY=sua-chave-publica-rsa-base64
# DEFENSE_IA_PRIVATE_KEY=opcional-para-decrypt-secretKey
# Teste rapido (doc 3.1): reutiliza publickey da 1a resposta
DEFENSE_IA_USE_SERVER_PUBLICKEY=false
DEFENSE_IA_ORG_CODE=001
DEFENSE_IA_KEEP_ALIVE_SECONDS=20
DEFENSE_IA_TIMEOUT_SECONDS=10

# Admin + sync BIODOC (mesmo Bearer). Startup grava hash na source "biodoc".
ADMIN_API_TOKEN=defina-um-token-seguro
DEFAULT_INTEGRATION_SOURCE_NAME=biodoc

# Opcional em producao: chave so do BIODOC (sobrescreve ADMIN no bootstrap)
# BIODOC_INTEGRATION_KEY=

# true = detalhe bruto do Defense em 502 (apenas homologação)
DEFENSE_IA_EXPOSE_ERROR=false

# Testes (foto: python scripts/download_test_face.py -> data/test_face.jpg)
TEST_FACE_IMAGE_PATH=data/test_face.jpg
MIDDLEWARE_URL=http://localhost:8000
